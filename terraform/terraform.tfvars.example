# Terraform Variables Configuration
# Copy this file to terraform.tfvars and fill in your values

# GCP Project Configuration
project_id = "your-gcp-project-id"
region     = "us-central1"

# Artifact Registry
artifact_registry_repo = "agentic-system"

# Cloud Run Service Account
cloud_run_service_account = "cloud-run-sa@your-project-id.iam.gserviceaccount.com"

# ============================================================================
# Neo4j Database Configuration
# ============================================================================
neo4j_uri      = "bolt://your-instance.databases.neo4j.io:7687"
neo4j_user     = "neo4j"
neo4j_password = "your-neo4j-password"

# ============================================================================
# Gemini API Configuration
# ============================================================================
gemini_api_key         = "your-gemini-api-key"
gemini_model_name      = "gemini-2.0-flash-exp"
gemini_embedding_model = "models/text-embedding-004"

# ============================================================================
# Application Configuration
# ============================================================================
secret_key = "your-random-secret-key"  # Generate: openssl rand -hex 32

# Optional: Tune these if needed
chunk_size             = "2000"
similarity_threshold   = "0.85"
confidence_threshold   = "0.7"
max_retrieval_results  = "10"

# ============================================================================
# How it works:
# ============================================================================
# 1. You provide values in this file (terraform.tfvars)
# 2. Terraform creates secrets in GCP Secret Manager with these values
# 3. Cloud Run fetches secrets from Secret Manager at runtime
# 4. Your sensitive data is stored securely in GCP, not in containers
# ============================================================================
